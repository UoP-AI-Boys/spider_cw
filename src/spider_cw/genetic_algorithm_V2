import random as rn
from kinematics import foot_positions

class Chromosome():
    def __int__(self):
        self.coxa = ()
        self.femur = ()
        self.tibia = ()
    
    def initialise_chromosomes(self):
        self.legs = []
        for i in range (0,8):
            self.coxa = rn.uniform (-0.52,0.52)
            self.femur = rn.uniform (-0.52,0)
            self.tibia = rn.uniform (-0.52,0)
            self.legs.append([self.coxa,self.femur,self.tibia])

    def __str__(self):
        return (f"leg:{self.legs}")

class Population():
    def __init__(self):
        self.population_size = 300
        self.population_chromosomes = []

    def generate_population(self):
        for i in range (0,self.population_size):
            self.chromosome = Chromosome()
            self.chromosome.initialise_chromosomes()
            self.population_chromosomes.append(self.chromosome)

    def return_unpacked_population(self):
        self.unpacked_array = []
        for chromosome in (self.population_chromosomes):
            for leg in (chromosome.legs):
                for joint in (leg):
                    self.unpacked_array.append(joint)
        return (self.unpacked_array)

    def return_unpacked_single_chromosome(self,chromosome):
        self.unpacked_chromosome = []
        for leg in self.chromosome.legs:
            for joint in leg:
                self.unpacked_chromosome.append(joint)
        return self.unpacked_chromosome


    def __str__(self):
        self.str = ""
        for i in self.population_chromosomes:
            self.str += str(f"spider: {i.legs} \n")
        return (f"a population of size: {self.population_size}... chromosomes: {self.str}")

